{
  "manifest_version": 3,
  "name": "Slash Pages",
  "version": "0.1.0",
  "description": "Shows the slash pages (/about, /now, /uses, …) of the current site, from its /.well-known/slashpages.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "slashpages@pfefferle.org",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "action": {
    "default_title": "Slash Pages",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "src/popup/popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ]
}
